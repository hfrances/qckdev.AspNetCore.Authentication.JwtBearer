@page "/ui/me"
@model JwtBearerExample.Identity.Pages.Ui.MeModel
@{
    ViewData["Title"] = "Identity Me";
    var roles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).Distinct().ToArray();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; margin: 2rem; max-width: 700px; line-height: 1.5; }
    </style>
</head>
<body>
    <h1>Authenticated User</h1>
    <p><a href="/ui">Back to UI home</a></p>
    <p><strong>Name:</strong> @(User.Identity?.Name ?? "unknown")</p>
    <p><strong>Roles:</strong> @(roles.Length == 0 ? "(none)" : string.Join(", ", roles))</p>
    <form method="post" action="/ui/logout">
        @Html.AntiForgeryToken()
        <button type="submit">Sign Out</button>
    </form>
</body>
</html>
