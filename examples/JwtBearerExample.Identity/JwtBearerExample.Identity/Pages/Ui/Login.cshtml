@page "/ui/login"
@model JwtBearerExample.Identity.Pages.Ui.LoginModel
@{
    ViewData["Title"] = "Identity Login";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; margin: 2rem; max-width: 700px; line-height: 1.5; }
        .error { color: #b91c1c; }
    </style>
</head>
<body>
    <h1>Local Identity Login</h1>
    <p><a href="/ui">Back to UI home</a></p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="error">@Model.ErrorMessage</p>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <label>Email: <input type="email" asp-for="Input.Email" /></label><br />
        <label>Password: <input type="password" asp-for="Input.Password" /></label><br />
        <button type="submit">Sign In</button>
    </form>

    <p>Try users: admin@local.dev / support@local.dev / viewer@local.dev</p>
</body>
</html>
