{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "JwtBearerExample.Identity",
      "Audience": "JwtBearerExample.Identity.Api",
      "Key": "local-demo-signing-key-for-jwt-identity-example-64-characters-long",
      "AccessExpireMinutes": 60
    }
  }
}
